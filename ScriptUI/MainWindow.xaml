<Window
    x:Class="ScriptUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScriptUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mcl="clr-namespace:DrawingListUC;assembly=DrawingListUC"
    Width="950"
    Height="700"
    mc:Ignorable="d"
    Closing="RibbonWindow_Closing"
    Icon="/Images/ScriptPro3.ico"
    Loaded="RibbonWindow_Loaded"
    Title="Script Pro 3.0 - 批处理工具">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Ribbon x:Name="Ribbon" Grid.Row="0" SelectedIndex="0">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed" />
            </Ribbon.ApplicationMenu>

            <RibbonTab x:Name="ManageTab" Header="ScriptPro">
                <RibbonGroup MinWidth="300" Header="列表" Width="277">
                    <RibbonButton x:Name="NewList" Click="NewList_Click" Label="新建" LargeImageSource="Images/script-new.png" />
                    <RibbonButton x:Name="WizardList" Click="WizardList_Click" Label="向导" LargeImageSource="Images/magic_wand_2.png" />
                    <RibbonButton x:Name="LoadList" Click="LoadList_Click" Label="加载" LargeImageSource="Images/script-add.png" />
                    <RibbonButton x:Name="SaveList" Click="SaveList_Click" Label="保存" LargeImageSource="Images/script-save.png" />
                    <RibbonButton x:Name="SaveAsList" Click="SaveAsList_Click" Label="另存为" LargeImageSource="Images/script-save.png" />
                    <RibbonButton x:Name="LoadSCP" Click="LoadSCP_Click" Label="加载 SCP 项目" LargeImageSource="Images/table_add.png" />
                </RibbonGroup>

                <RibbonGroup MinWidth="260" Header="图纸文件">
                    <RibbonButton x:Name="AddDWGFile" Click="AddDWGFile_Click" Label="添加文件" LargeImageSource="Images/add.png" />
                    <RibbonButton x:Name="AddDWGFolder" Click="AddDWGFolder_Click" Label="添加文件夹" LargeImageSource="Images/folder_add.png" />
                    <RibbonButton x:Name="RemoveDWG" Click="RemoveDWG_Click" Label="移除" LargeImageSource="Images/delete.png" />
                    <RibbonButton x:Name="SkipDWG" Click="SkipDWG_Click" Label="勾选/取消" LargeImageSource="Images/checked-unchecked.png" />
                </RibbonGroup>

                <RibbonGroup MinWidth="160" Header="执行">
                    <RibbonButton x:Name="RunChecked" Click="RunChecked_Click" Label="执行勾选项" LargeImageSource="Images/script-go-checked.png" />
                    <RibbonButton x:Name="RunSelected" Click="RunSelected_Click" Label="执行选中项" LargeImageSource="Images/script-go-selected.png" />
                    <RibbonButton x:Name="RunFailed" Click="RunFailed_Click" Label="重试失败项" LargeImageSource="Images/script-go-failed.png" />
                </RibbonGroup>

                <RibbonGroup MinWidth="60" Header="停止">
                    <RibbonButton x:Name="StopProcess" Click="StopProcess_Click" Label="停止" LargeImageSource="Images/stop.png" />
                </RibbonGroup>

                <RibbonGroup MinWidth="60" Header="选项">
                    <RibbonButton x:Name="ProcessOptions" Click="ProcessOptions_Click" Label="设置" LargeImageSource="Images/wrench.png" />
                </RibbonGroup>

                <RibbonGroup MinWidth="60" Header="帮助">
                    <RibbonButton x:Name="ProcessHelp" Click="ProcessHelp_Click" Label="帮助" LargeImageSource="Images/help.png" />
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <Border Grid.Row="1" Padding="10,10,10,10">
            <WindowsFormsHost Name="DrawingListUserControl">
                <mcl:DrawingListControl x:Name="DWGControl" />
            </WindowsFormsHost>
        </Border>

    </Grid>
</Window>